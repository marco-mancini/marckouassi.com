{
  "name": "marckouassi-com",
  "private": true,
  "description": "Portfolio de Marc Kouassi — site statique",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --experimental-strip-types --no-warnings --test 'tests/*.test.mjs'",
    "test:navigateur": "node --test --test-concurrency=1 'tests/navigateur/*.test.mjs'",
    "verifier": "npm test && npm run build && npm run test:navigateur",
    "comparer-reference": "node tools/comparer-reference.mjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "5.3.8",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/noto-mono": "5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@sveltia/cms": "0.227.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "1.56.1"
  }
}
